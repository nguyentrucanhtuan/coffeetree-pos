[options]
; Database
db_host = db
db_port = 5432
db_user = odoo
db_password = odoo
db_name = False

; Addons paths (core + custom)
addons_path = /opt/odoo/addons,/mnt/custom_addons

; Data directory (persistent)
data_dir = /var/lib/odoo

; Master password - CHANGE THIS!
admin_passwd = CHANGE_ME

; Workers (0 = single-threaded, phù hợp cho dev)
workers = 0

; Logging
log_level = info

; HTTP
xmlrpc_port = 8069
longpolling_port = 8072

; Timeout
limit_time_cpu = 600
limit_time_real = 1200
